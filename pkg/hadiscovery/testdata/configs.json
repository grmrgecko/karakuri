  },
  "number_template": {
    "topic": "homeassistant/number/brightness/config",
    "payload": {"name": "Level", "uniq_id": "lvl1", "cmd_t": "lvl1/set", "cmd_tpl": "{\"level\": {{ value | int }}}", "stat_t": "lvl1/state", "val_tpl": "{{ value_json.level | float(0) / 10 }}", "min": 0, "max": 10, "step": 0.5}
  },
  "device_based": {
    "topic": "homeassistant/device/node1/config",
    "payload": {"dev": {"ids": "node1", "name": "Node"}, "o": {"name": "custom"}, "cmps": {"temp": {"p": "sensor", "unit_of_meas": "°C", "val_tpl": "{{ value_json.t }}", "uniq_id": "node1_t"}, "btn": {"p": "button", "cmd_t": "node1/reboot", "pl_prs": "REBOOT", "name": "Reboot", "uniq_id": "node1_btn"}}, "stat_t": "node1/state"}
