  "esphome_light": {
    "topic": "homeassistant/light/desk/desk_lamp/config",
    "payload": {"name": "Desk lamp", "schema": "json", "brightness": true, "sup_clrm": ["rgb"], "stat_t": "desk/light/desk_lamp/state", "cmd_t": "desk/light/desk_lamp/command", "avty_t": "desk/status", "uniq_id": "ESPlightdesk_lamp", "dev": {"ids": "a0b1c2d3e4f5", "name": "desk", "mf": "Espressif"}}
  },
  "esphome_cover": {
    "topic": "homeassistant/cover/garage/door/config",
    "payload": {"name": "Door", "dev_cla": "garage", "~": "garage/cover/door", "stat_t": "~/state", "cmd_t": "~/command", "pos_t": "~/position/state", "set_pos_t": "~/position/command", "avty_t": "garage/status", "uniq_id": "ESPcoverdoor", "dev": {"ids": "aabbccddeeff", "name": "garage"}}
  },
  "shelly_binary": {
    "topic": "homeassistant/binary_sensor/shellyplus1-abc_input/config",
    "payload": {"name": "Input", "uniq_id": "shellyplus1-abc_input", "stat_t": "shellyplus1-abc/status/input:0", "val_tpl": "{{ 'ON' if value_json.state else 'OFF' }}", "dev_cla": "door", "dev": {"ids": ["shellyplus1-abc"], "name": "Garage input"}}
  },
  "climate": {
    "topic": "homeassistant/climate/hvac1/config",
