    "payload": {"name": null, "stat_t": "tele/plug1/STATE", "avty_t": "tele/plug1/LWT", "pl_avail": "Online", "pl_not_avail": "Offline", "cmd_t": "cmnd/plug1/POWER", "val_tpl": "{{value_json.POWER}}", "pl_off": "OFF", "pl_on": "ON", "uniq_id": "A1B2C3_RL_1", "dev": {"ids": ["A1B2C3"], "name": "Plug1", "mdl": "Sonoff Basic", "mf": "Tasmota"}}
  },
  "tasmota_power": {
