# Version-control metadata and local tool state.
.git/
.idea/
.vscode/

# Generated server, frontend, and release output.
build/
dist/
.cache/

# Dependencies restored during the image build.
node_modules/
frontend/node_modules/
frontend/dist/
pkg/http/dist/*
!pkg/http/dist/.gitkeep
plugins/*/widgets/*/node_modules/
plugins/*/widgets/*/dist/

# Local configuration, credentials, databases, and logs.
.env*
.release-env
config.yaml
config.local.yaml
*.db
*.db-shm
*.db-wal
*.log
go.work
go.work.sum

# Binaries accidentally built in the checkout instead of build/.
/karakuri
/karakuri-agent
/karakuri-auto
/calendar
/crypto
/stock
/weather

# Test and coverage output.
*.test
*.out
coverage/
coverage.html

# macOS signing and notarization credentials.
.signing/
